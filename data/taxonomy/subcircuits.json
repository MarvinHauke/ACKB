	{
		"id": "voltage-follower",
		"label": "Voltage Follower",
		"parent": "opamp-stage",
		"pdfOcrKind": "voltage_follower",
		"aliases": [
			"buffer",
			"unity-gain buffer",
			"op-amp buffer"
		],
		"group": "opamp-stages",
		"description": "An op-amp stage with its output tied straight back to the inverting input, giving a gain of one with high input and low output impedance. Synths use it as a buffer to isolate circuit stages or drive long cables."
	},
	{
		"id": "integrator",
		"label": "Integrator",
		"parent": "opamp-stage",
		"pdfOcrKind": "integrator",
		"aliases": [
			"filter pole",
			"OTA integrator"
		],
		"group": "opamp-stages",
		"description": "A circuit whose output follows the accumulated input over time, made from an op-amp or OTA with a capacitor. Chains of integrators form filter poles, and a single one generates ramps and triangle waves in oscillators and envelopes."
	},
	{
		"id": "comparator",
		"label": "Comparator Stage",
		"pdfOcrKind": "comparator",
		"aliases": [
			"schmitt trigger"
		],
		"group": "opamp-stages",
		"description": "A stage that compares two voltages and switches its output high or low depending on which is larger, often with feedback for hysteresis (Schmitt trigger). Synths use it to turn waveforms into gates and triggers, generate pulse waves and reset oscillators."
	},
	{
		"id": "ota-stage",
		"label": "OTA Stage",
		"aliases": [
			"operational transconductance amplifier",
			"OTA"
		],
		"description": "A stage built around an operational transconductance amplifier, whose gain is set by a bias current, so a control voltage can change it. In synths it appears in voltage-controlled filters, amplifiers and oscillators; the LM13700 and the older CA3080 are the usual parts.",
		"group": "transistor-stages"
	},
	{
		"id": "differential-pair",
		"label": "Differential Pair",
		"pdfOcrKind": "differential_pair",
		"aliases": [
			"long-tailed pair",
			"LTP"
		],
		"group": "transistor-stages",
		"description": "Two matched transistors with joined emitters (or sources) fed from one current source, so the output depends on the difference between the two inputs. It is the input stage of op-amps and OTAs and the basis of many transistor filter and VCA cells."
	},
