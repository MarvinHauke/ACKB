[
	{
		"id": "opamp-stage",
		"label": "Op-Amp Stage",
		"pdfOcrKind": "opamp_stage",
		"description": "A stage built around one op-amp, with resistors and capacitors around it setting gain, inversion, summing or buffering. It is the generic tag, used when no more specific op-amp subcircuit (follower, inverting amp, integrator, …) fits.",
		"group": "opamp-stages"
	},
