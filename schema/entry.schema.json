{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ackb.local/schema/entry.schema.json",
	"title": "ACKB entry",
	"description": "One knowledge entry: a circuit topic with its external sources. The file name is the entry id.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "title", "summary", "circuitTypes", "kinds", "added", "sources"],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"title": { "type": "string", "minLength": 3, "maxLength": 120 },
		"summary": { "type": "string", "minLength": 20, "maxLength": 600 },
		"manufacturers": { "$ref": "#/$defs/idList", "description": "Ids from data/taxonomy/manufacturers.json" },
		"products": { "$ref": "#/$defs/idList", "description": "Ids from data/taxonomy/products.json" },
		"circuitTypes": { "$ref": "#/$defs/idList", "minItems": 1, "description": "Ids from data/taxonomy/circuit-types.json" },
		"subcircuits": { "$ref": "#/$defs/idList", "description": "Ids from data/taxonomy/subcircuits.json" },
		"functions": { "$ref": "#/$defs/idList", "description": "Ids from data/taxonomy/functions.json" },
		"ics": { "$ref": "#/$defs/idList", "description": "Ids from data/taxonomy/ics.json" },
		"kinds": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "enum": ["build-guide", "explanation", "analysis", "schematic", "reference"] },
			"description": "What the resources are: step-by-step build, how it works, maths/measurements, bare schematics, or reference material (manuals, datasheets, calculators)."
		},
		"added": { "type": "string", "format": "date" },
		"reviewed": { "type": "string", "format": "date" },
		"sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" },
		"idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "title", "url"],
			"properties": {
				"type": { "enum": ["website", "paper", "datasheet", "patent", "github", "video", "forum", "manual", "schematic"] },
				"title": { "type": "string", "minLength": 3 },
				"url": { "type": "string", "format": "uri", "pattern": "^https?://" },
				"author": { "type": "string" },
				"origin": {
					"enum": ["manufacturer", "academic"],
					"description": "Who published it, when the type doesn't say (e.g. a university lecture video). Sets the entry's confidence."
				},
				"year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
				"lang": { "type": "string", "pattern": "^[a-z]{2}$", "description": "ISO 639-1, default en" },
				"license": { "type": "string" },
				"note": { "type": "string", "maxLength": 300 }
			}
		}
	}
}
