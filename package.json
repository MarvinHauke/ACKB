{
	"name": "electronikc-knowledgebase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run data && vite dev",
		"data": "node scripts/build-data.js",
		"validate": "node scripts/validate.js",
		"new": "node scripts/new-entry.js",
		"links": "node scripts/check-links.js",
		"prebuild": "npm run data",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run validate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.20.4",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"fuse.js": "^7.5.0"
	},
	"engines": {
		"node": ">=22"
	}
}
