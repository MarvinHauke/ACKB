{
	"json.schemas": [
		{ "fileMatch": ["data/articles/*.json"], "url": "./schema/article.schema.json" },
		{ "fileMatch": ["data/references.json"], "url": "./schema/reference.schema.json" },
		{ "fileMatch": ["data/taxonomy/products.json"], "url": "./schema/taxonomy/product.schema.json" },
		{ "fileMatch": ["data/taxonomy/components.json"], "url": "./schema/taxonomy/component.schema.json" },
		{ "fileMatch": ["data/taxonomy/subcircuits.json"], "url": "./schema/taxonomy/subcircuit.schema.json" },
		{ "fileMatch": ["data/taxonomy/authors.json"], "url": "./schema/taxonomy/author.schema.json" },
		{
			"fileMatch": [
				"data/taxonomy/manufacturers.json",
				"data/taxonomy/modules.json",
				"data/taxonomy/functions.json"
			],
			"url": "./schema/taxonomy/term.schema.json"
		}
	]
}
